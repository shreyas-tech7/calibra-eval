# Copy to .env and fill in only for record mode. Never commit .env.
# Any OpenAI-compatible endpoint works, for example Groq or OpenRouter free tiers.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# The adapter reads the key from this variable. Leave it empty to send no auth header.
LLM_API_KEY=
